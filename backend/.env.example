# ── Database (Postgres-first; SQLite dev default) ────────────────────────────
# Local development, zero infra (default when unset):
# DATABASE_URL=sqlite:///./data/faircv.db
# Supabase / Render Postgres (install psycopg2-binary and uncomment):
# DATABASE_URL=postgresql+psycopg2://user:password@host:5432/dbname

# ── Audit engine ─────────────────────────────────────────────────────────────
# Path to the frozen FairCV dataset used by demo-mode audits.
# This file is local-only (git-ignored) — it must exist on the server that
# runs demo audits. Defaults to <repo root>/FairCVdb.npy.
# FAIRCV_DB_PATH=../FairCVdb.npy
# AUDIT_N_BOOT=2000
# AUDIT_SEED=42

# ── Uploads ──────────────────────────────────────────────────────────────────
# MAX_UPLOAD_MB=50

# ── CORS (comma-separated origins) ───────────────────────────────────────────
# CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ── AI Assistant (Groq) ───────────────────────────────────────────────────────
# The Groq API key MUST live only here — never in the React/Vite frontend.
# The frontend calls POST /api/assistant/chat; this backend proxies to Groq.
# Get a free key at https://console.groq.com
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
